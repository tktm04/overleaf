WEBPACK_HOST=webpack
WEB_API_PASSWORD=overleaf
WEB_API_USER=overleaf
WEB_HOST=web
# Claude Review feature — talks to the host-side claude-sidecar
# (run separately: cd tools/claude-sidecar && npm start)
OVERLEAF_CLAUDE_SIDECAR_URL=http://host.docker.internal:8888
OVERLEAF_CLAUDE_MODEL=claude-opus-4-7
# Personal-use unlock: enables Server Pro features (Track Changes, Review Panel rail).
# Only safe for self-hosted single-user installs.
OVERLEAF_UNLOCK_PRO=true
